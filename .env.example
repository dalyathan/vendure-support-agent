# Use the Vendure store instead of the in-memory one
STORE_BACKEND=vendure
STORE_NAME="Example Store"

# Vendure Admin API (a local dev server runs on port 3000 by default)
VENDURE_ADMIN_API_URL=http://localhost:3000/admin-api

# Either an API key (Vendure 3.6+, with 'api-key' in authOptions.tokenMethod)...
# VENDURE_API_KEY=

# ...or a dedicated low-privilege administrator. These are the local-dev values that
# `npm run vendure:setup-dev` creates; never reuse them anywhere real.
VENDURE_USERNAME=support-agent@example.com
VENDURE_PASSWORD=local-dev-only

# Only for a custom order process: extra Vendure states mapped onto the policy's statuses
# (pending, shipped, delivered, cancelled, other). States not mapped become "other".
# VENDURE_STATE_MAP='{"AwaitingFulfillment":"pending"}'

# For `vendure:setup-dev --place-order` and `test:vendure`: a test customer on your dev server
VENDURE_TEST_CUSTOMER=
VENDURE_TEST_CUSTOMER_PASSWORD=
# Code of a payment method that settles immediately (a dev/test payment method)
VENDURE_TEST_PAYMENT_METHOD=
# VENDURE_TEST_COUNTRY_CODE=US
